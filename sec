              "curl", "wget", "nc", "ssh", "scp", "rsync", "base64", "xxd", "openssl"}
SENSITIVE_PREFIXES = ("~/.ssh", "/etc/", "~/.config", "~/.local/state", "/root", "~/.gnupg", "/proc/")
SHELLS = {"sh", "bash", "dash", "zsh"}
HOST_RE = re.compile(r"(?:[a-z0-9-]+\.)+[a-z]{2,}(?::\d+)?", re.I)


def risk_profile(argv):
    """对命令做静态体检：分数决定页面要几次确认。"""
    prog = os.path.basename(argv[0]) if argv else ""
    joined = " ".join(argv)
    score = 0
    signals, hosts = [], []
    script = ""
    tokens = {os.path.basename(a) for a in argv}
    if prog in SHELLS and "-c" in argv:
        i = argv.index("-c")
        script = argv[i + 1] if i + 1 < len(argv) else ""
        if any(ch in script for ch in (";", "|", "$(", "&&", "||", ">")):
            score += 25; signals.append("shell 拼接")
        tokens |= {os.path.basename(t) for t in script.split()}
    net_hit = sorted(tokens & NET_TOOLS)
    enc_hit = sorted(tokens & ENCODE_TOOLS)
    if net_hit:
        score += 40; signals.append("网络出口：" + "、".join(net_hit))
    if enc_hit:
        score += 30; signals.append("编码/变换：" + "、".join(enc_hit))
    if prog and prog not in KNOWN_BINS:
        score += 15; signals.append(f"非惯用程序 {prog}")
    for a in argv:
        if any(prefix in a for prefix in SENSITIVE_PREFIXES):
            score += 20; signals.append("涉及敏感路径"); break
    if len(argv) + len(script.split()) > 40:
        score += 10; signals.append("命令过长")
    for match in HOST_RE.finditer(joined):
        host = match.group(0)
        if host.replace(".", "").isdigit():
            continue
        hosts.append(host)
    level = "high" if score >= 60 else ("medium" if score >= 30 else "low")
    return {"score": score, "level": level, "signals": signals, "hosts": sorted(set(hosts))[:6]}


def tail(text, limit=OUTPUT_LIMIT):
    return text if len(text) <= limit else text[-limit:]


def run_request(item, values):
    """在子进程里执行命令：值只进 env 或 stdin，不进 argv。"""
    env = os.environ.copy()
    stdin_data = None
    if item["stdin"]:
        stdin_data = values["VALUE"]
    else:
        env.update(values)
    try:
        proc = subprocess.run(
            item["argv"], env=env,
            input=stdin_data.encode() if stdin_data is not None else None,
            capture_output=True, timeout=CMD_TIMEOUT, cwd=os.getcwd(),
        )
        code, out, err = proc.returncode, proc.stdout.decode("utf-8", "replace"), proc.stderr.decode("utf-8", "replace")
        outcome = "exited"
    except subprocess.TimeoutExpired:
        code, out, err, outcome = None, "", f"命令超过 {CMD_TIMEOUT}s 被终止", "timeout"
    except FileNotFoundError as exc:
        code, out, err, outcome = None, "", f"无法执行：{exc}", "not-started"
    except Exception as exc:  # noqa: BLE001
        code, out, err, outcome = None, "", f"执行失败：{exc}", "error"
    return {
        "state": "ran", "outcome": outcome, "exit": code,
        "stdout": tail(redact(out, values)),
        "stderr": tail(redact(err, values)),
        "redacted": sorted(values),
        "duration_ms": None,
    }


