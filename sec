def configured_port():
    """SEC_PORT 固定端口；未设置则每次拉起时随机选。"""
    raw = os.environ.get("SEC_PORT")
    return int(raw) if raw else None


def public_base(port):
    override = os.environ.get("SEC_PUBLIC_BASE")
    if override:
        return override.rstrip("/")
    return f"http://127.0.0.1:{port}"


# ---------------------------------------------------------------- 状态（仅内存）

class Store:
    def __init__(self):
        self.lock = threading.Lock()
        self.items = {}

    def new(self, argv, reason, envs, stdin_mode, ttl):
        if len([i for i in self.items.values() if i["state"] == "pending"]) >= MAX_PENDING:
            raise RuntimeError("待处理请求过多，先处理或等它们过期")
        rid = secrets.token_urlsafe(24)
        now = time.time()
        with self.lock:
            self.items[rid] = {
                "id": rid, "argv": argv, "reason": reason, "envs": envs,
                "risk": risk_profile(argv),
                "stdin": stdin_mode, "created": now, "expires": now + ttl,
                "state": "pending", "used": False, "result": None,
            }
        return rid

    def get(self, rid):
        with self.lock:
            return self.items.get(rid)

    def sweep(self):
        now = time.time()
        with self.lock:
            for rid, item in list(self.items.items()):
                if item["state"] == "pending" and now > item["expires"]:
                    item["state"] = "expired"
                if item["state"] != "pending" and now > item["expires"] + 3600:
                    del self.items[rid]

    def pending(self):
        with self.lock:
            return [i for i in self.items.values() if i["state"] == "pending"]


STORE = Store()


def redact(text, values):
    """把每个值替换成 [secret:NAME]；短值也要替换（宁可误伤可读性）。"""
    if not text:
        return ""
    for name, value in sorted(values.items(), key=lambda kv: -len(kv[1])):
        if not value:
            continue
        text = text.replace(value, f"[secret:{name}]")
    return text


