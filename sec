def _block(lang, text):
    fence = "~~~"
    return f"{fence}{lang}\n{text.rstrip()}\n{fence}"


def risk_line(item):
    risk = item.get("risk") or {}
    level = {"low": "低", "medium": "中", "high": "高"}.get(risk.get("level", "low"), "低")
    parts = [f"**{level}**（score {risk.get('score', 0)}）"]
    if risk.get("signals"):
        parts.append("、".join(risk["signals"]))
    if risk.get("hosts"):
        parts.append("目标主机：" + "、".join(f"`{h}`" for h in risk["hosts"]))
    return " · ".join(parts)


def md_pending(item, url):
    left = max(0, int(item["expires"] - time.time()))
    inject = "stdin" if item["stdin"] else "env " + ", ".join(f"`{n}`" for n in item["envs"])
    return "\n".join([
        "### 🔐 sec · 等待确认执行",
        "",
        f"**{item['reason'] or '执行命令'}**",
        "",
        _block("sh", shlex.join(item["argv"])),
        f"- 注入：{inject}",
        f"- 风险：{risk_line(item)}",
        f"- 有效期：{left}s（成功后链接立即作废）",
        "- 密码只提交到该页面，不进对话、不发模型",
        "",
        f"**[打开并输入密码 →]({url})**",
    ])


def md_result(item):
    result = item["result"] or {}
    state = item["state"]
    cmd = _block("sh", shlex.join(item["argv"]))
    if state == "denied":
        return "\n".join(["### ⛔ sec · 已拒绝", "", cmd, "没有执行任何命令。"])
    if state == "expired":
        return "\n".join(["### ⌛ sec · 已过期", "", cmd, "链接到期作废，命令没有执行。"])
    if not result:
        return "\n".join(["### ⏳ sec · 执行中", "", cmd, "结果稍后返回。"])
    ok = result.get("exit") == 0 and result.get("outcome") == "exited"
    redacted = result.get("redacted") or []
    meta = (f"`exit {result.get('exit')}` · `{result.get('outcome')}` · "
            f"`{result.get('duration_ms')}ms`")
    if redacted:
        meta += " · 已脱敏：" + ", ".join(f"`{n}`" for n in redacted)
    lines = [f"### {'✅' if ok else '⚠️'} sec · {'执行完成' if ok else '执行结束'}", "", meta, "", cmd]
    for label in ("stdout", "stderr"):
        text = result.get(label) or ""
        if text.strip():
            lines += ["", f"**{label}**", _block("text", text)]
    return "\n".join(lines)


# ---------------------------------------------------------------- HTTP

class Handler(BaseHTTPRequestHandler):
    server_version = "sec/" + VERSION
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        sys.stderr.write("%s %s\n" % (time.strftime("%Y-%m-%dT%H:%M:%S"), fmt % args))

    def _send(self, code, body, ctype="text/html; charset=utf-8", extra=None):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Content-Security-Policy",
                         "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def _json(self, code, obj):
        self._send(code, json.dumps(obj, ensure_ascii=False), "application/json; charset=utf-8")

    def _auth_ok(self):
        token = TOKENFILE.read_text().strip() if TOKENFILE.exists() else ""
        return bool(token) and self.headers.get("X-Sec-Token") == token

    def _base(self):
        return public_base(self.server.server_address[1])

    def _host_ok(self):
        host = self.headers.get("Host", "")
        if host.startswith("127.0.0.1") or host.startswith("localhost"):
            return True
        base = urllib.parse.urlsplit(self._base())
        return host == base.netloc

    def _body(self, limit=MAX_VALUE * 2):
        length = int(self.headers.get("Content-Length") or 0)
        if length > limit:
            raise ValueError("请求体过大")
        return self.rfile.read(length).decode("utf-8", "replace")

    def do_GET(self):
        path = urllib.parse.urlsplit(self.path).path
        if path == "/healthz":
            return self._json(200, {"ok": True, "pid": os.getpid(), "version": VERSION})
        if not self._host_ok():
            return self._send(404, page("未找到", "<h1>404</h1>"))
        parts = [p for p in path.split("/") if p]
        if len(parts) >= 2 and parts[0] == "r":
            item = STORE.get(parts[1])
            if not item:
                return self._send(404, page("无效链接", "<h1>无效或已失效的链接</h1>"))
            if item["state"] == "pending":
                return self._send(200, render_review(item))
            if item["state"] in ("denied", "expired"):
                return self._send(200, render_done(item))
            return self._send(200, render_done(item))
        return self._send(404, page("未找到", "<h1>404</h1>"))

    def do_POST(self):
        path = urllib.parse.urlsplit(self.path).path
        if path == "/api/request":
            if not self._auth_ok():
                return self._json(403, {"error": "forbidden"})
            try:
                payload = json.loads(self._body())
                argv = [str(a) for a in payload.get("argv") or []]
                if not argv:
                    raise ValueError("argv 不能为空")
                envs = [str(n) for n in payload.get("envs") or []]
                stdin_mode = bool(payload.get("stdin"))
                if not envs and not stdin_mode:
                    raise ValueError("必须指定 --env 或 --stdin")
                if envs and stdin_mode:
                    raise ValueError("--env 与 --stdin 不能同时使用")
                for name in envs:
                    if not name.replace("_", "").isalnum() or not name[0].isalpha():
                        raise ValueError(f"非法环境变量名：{name}")
                ttl = max(30, min(MAX_TTL, int(payload.get("ttl") or DEFAULT_TTL)))
                rid = STORE.new(argv, str(payload.get("reason") or ""), envs, stdin_mode, ttl)
            except Exception as exc:  # noqa: BLE001
                return self._json(400, {"error": str(exc)})
            item = STORE.get(rid)
            url = f"{self._base()}/r/{rid}"
            return self._json(200, {
                "id": rid, "url": url,
                "expires": int(item["expires"]), "ttl": ttl,
                "instructions": GUIDE_SHORT,
                "render": md_pending(item, url),
            })
        if path == "/api/pending":
            if not self._auth_ok():
                return self._json(403, {"error": "forbidden"})
            items = [{
                "id": i["id"], "argv": i["argv"], "reason": i["reason"],
                "expires": int(i["expires"]), "risk": i["risk"],
            } for i in STORE.pending()]
            return self._json(200, {"pending": items})
        if path == "/api/status":
            if not self._auth_ok():
                return self._json(403, {"error": "forbidden"})
            try:
                rid = str(json.loads(self._body()).get("id") or "")
            except Exception:  # noqa: BLE001
                return self._json(400, {"error": "bad body"})
            item = STORE.get(rid)
            if not item:
                return self._json(404, {"error": "not found"})
            url = f"{self._base()}/r/{rid}"
            if item["state"] == "pending":
                return self._json(200, {
                    "id": rid, "state": "pending", "expires": int(item["expires"]), "url": url,
                    "instructions": GUIDE_SHORT,
                    "render": md_pending(item, url),
                })
            return self._json(200, {
                "id": rid, "state": item["state"], "expires": int(item["expires"]),
                "result": item["result"] or {},
                "render": md_result(item),
            })
        parts = [p for p in path.split("/") if p]
        if len(parts) == 2 and parts[0] == "r":
            item = STORE.get(parts[1])
            if not item:
                return self._send(404, page("无效链接", "<h1>无效或已失效的链接</h1>"))
            if item["state"] != "pending" or item["used"]:
                return self._send(410, page("已作废", "<h1>这个链接已经用过了</h1>"))
            try:
                form = urllib.parse.parse_qs(self._body(), keep_blank_values=True)
            except Exception as exc:  # noqa: BLE001
                return self._send(400, page("格式错误", f"<h1>格式错误</h1><p>{html.escape(str(exc))}</p>"))
            decision = (form.get("decision") or [""])[0]
            item["used"] = True
            if decision != "run":
                item["state"] = "denied"
                return self._send(303, "", extra={"Location": f"/r/{item['id']}/done"})
            risk = item.get("risk") or {}
            if risk.get("level") == "medium" and (form.get("ack") or [""])[0] != "1":
                item["used"] = False
                return self._send(400, page("需要确认",
                    "<h1>请先勾选「我已核对命令」</h1><p>返回上一页重新提交。</p>"))
            if risk.get("level") == "high" and (form.get("confirm") or [""])[0].strip() != "RUN":
                item["used"] = False
                return self._send(400, page("需要确认",
                    "<h1>高风险命令：请在确认框输入 RUN</h1><p>返回上一页重新提交。</p>"))
            if item["stdin"]:
                value = (form.get("value") or [""])[0]
                if not value.strip():
                    item["used"] = False
                    return self._send(400, page("缺少密码", "<h1>密码为空</h1>"))
                values = {"VALUE": value}
            else:
                values = {}
                for name in item["envs"]:
                    value = (form.get("v_" + name) or [""])[0]
                    if not value.strip():
                        item["used"] = False
                        return self._send(400, page("缺少密码", f"<h1>{html.escape(name)} 为空</h1>"))
                    if len(value) > MAX_VALUE:
                        item["used"] = False
                        return self._send(413, page("过大", "<h1>值过长</h1>"))
                    values[name] = value
            item["state"] = "running"
            started = time.time()
            def work():
                result = run_request(item, values)
                result["duration_ms"] = int((time.time() - started) * 1000)
                item["result"] = result
                item["state"] = "ran"
            threading.Thread(target=work, daemon=True).start()
            return self._send(303, "", extra={"Location": f"/r/{item['id']}/done"})
        return self._json(404, {"error": "not found"})


def serve(port):
    STATE.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(STATE, 0o700)
    except OSError:
        pass
    if not TOKENFILE.exists():
        TOKENFILE.write_text(secrets.token_urlsafe(32))
        os.chmod(TOKENFILE, 0o600)
    PIDFILE.write_text(str(os.getpid()))
    PORTFILE.write_text(str(port))
    httpd = ThreadingHTTPServer(("0.0.0.0", port), Handler)
    httpd.daemon_threads = True
    httpd.allow_reuse_address = True

    def sweeper():
        while True:
            time.sleep(5)
            try:
                STORE.sweep()
            except Exception:  # noqa: BLE001
                pass

    threading.Thread(target=sweeper, daemon=True).start()
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: threading.Thread(target=httpd.shutdown, daemon=True).start())
    sys.stderr.write(f"sec {VERSION} listening on 0.0.0.0:{port} pid={os.getpid()}\n")
    sys.stderr.flush()
    try:
        httpd.serve_forever()
    finally:
        try:
            PIDFILE.unlink()
        except OSError:
            pass


# ---------------------------------------------------------------- 客户端

def api(port, path, payload):
    token = TOKENFILE.read_text().strip()
    req = urllib.request.Request(
        f"http://127.0.0.1:{port}{path}", method="POST",
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json", "X-Sec-Token": token},
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as exc:
        raw = exc.read().decode("utf-8", "replace")
        try:
            detail = json.loads(raw)
        except Exception:  # noqa: BLE001
            detail = {"error": raw or str(exc)}
        detail["http_status"] = exc.code
        raise RuntimeError(detail.get("error") or str(exc)) from None


def healthy(port, timeout=0.6):
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/healthz", timeout=timeout) as resp:
            return json.loads(resp.read()).get("ok") is True
    except Exception:  # noqa: BLE001
        return False


def read_port():
    fixed = configured_port()
    if fixed:
        return fixed
    try:
        return int(PORTFILE.read_text().strip())
    except Exception:  # noqa: BLE001
        return None


def pick_port():
    fixed = configured_port()
    if fixed:
        return fixed
    for _ in range(60):
        port = PORT_MIN + secrets.randbelow(max(1, PORT_MAX - PORT_MIN + 1))
        try:
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
                probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                probe.bind(("0.0.0.0", port))
            return port
        except OSError:
            continue
    raise SystemExit(f"{PORT_MIN}-{PORT_MAX} 里找不到空闲端口")


def ensure_server():
    port = read_port()
    if port and healthy(port):
        return port
    STATE.mkdir(parents=True, exist_ok=True)
    with open(LOCKFILE, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        port = read_port()
        if port and healthy(port):
            return port
        port = pick_port()
        log = open(LOGFILE, "ab", buffering=0)  # noqa: SIM115
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "serve", "--port", str(port)],
            stdin=subprocess.DEVNULL, stdout=log, stderr=log,
            start_new_session=True, close_fds=True,
        )
        deadline = time.time() + 10
        while time.time() < deadline:
            if healthy(port, 0.3):
                PORTFILE.write_text(str(port))
                return port
            time.sleep(0.15)
        raise SystemExit(f"服务拉不起来（端口 {port}），看日志：{LOGFILE}")


def remember(rid):
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        LASTFILE.write_text(rid)
        os.chmod(LASTFILE, 0o600)
    except OSError:
        pass


def last_id():
    try:
        rid = LASTFILE.read_text().strip()
    except OSError:
        rid = ""
    return rid or None


def die(msg, code=1):
    print(json.dumps({"error": msg}, ensure_ascii=False))
    sys.exit(code)


def cmd_request(args):
    argv = list(args.command)
    if not argv:
        die("缺少命令：在 -- 之后写")
    if bool(args.env) == bool(args.stdin):
        die("必须且只能选一种注入方式：--env NAME（可重复）或 --stdin")
    port = ensure_server()
    payload = {"argv": argv, "envs": args.env or [], "stdin": args.stdin,
               "reason": args.reason or "", "ttl": args.ttl}
    try:
        out = api(port, "/api/request", payload)
    except Exception as exc:  # noqa: BLE001
        die(f"创建请求失败：{exc}")
    remember(out["id"])
    print(json.dumps(out, ensure_ascii=False, indent=2))
    return 0


def cmd_wait(args):
    rid = args.id or last_id()
    if not rid:
        die("没有请求 id，也没有 --last 记录")
    port = ensure_server()
    deadline = time.time() + args.timeout
    last = None
    while time.time() < deadline:
        try:
            out = api(port, "/api/status", {"id": rid})
        except Exception as exc:  # noqa: BLE001
            msg = str(exc)
            if msg == "not found":
                die("请求不存在：服务重启会丢弃内存中的请求，请重新 sec request")
            die(f"查询失败：{msg}")
        last = out
        if out.get("state") in ("ran", "denied", "expired"):
            print(json.dumps(out, ensure_ascii=False, indent=2))
            return 0
        time.sleep(1)
    print(json.dumps(last or {"id": rid, "state": "pending"}, ensure_ascii=False, indent=2))
    return 0


def cmd_status(args):
    rid = args.id or last_id()
    if not rid:
        die("没有请求 id，也没有 --last 记录")
    port = ensure_server()
    try:
        out = api(port, "/api/status", {"id": rid})
    except Exception as exc:  # noqa: BLE001
        if str(exc) == "not found":
            die("请求不存在：服务重启会丢弃内存中的请求，请重新 sec request")
        die(f"查询失败：{exc}")
    print(json.dumps(out, ensure_ascii=False, indent=2))
    return 0


def cmd_guide(args):
    print(GUIDE_FULL, end="")
    return 0


def cmd_render(args):
    rid = args.id or last_id()
    if not rid:
        die("没有请求 id，也没有 --last 记录")
    port = ensure_server()
    out = api(port, "/api/status", {"id": rid})
    print(out.get("render") or "")
    return 0


def cmd_list(args):
    port = ensure_server()
    out = api(port, "/api/pending", {})
    print(json.dumps(out, ensure_ascii=False, indent=2))
    return 0


def cmd_stop(args):
    if not PIDFILE.exists():
        print(json.dumps({"stopped": False, "reason": "没有 pid 文件"}, ensure_ascii=False))
        return 0
    try:
        pid = int(PIDFILE.read_text().strip())
        os.kill(pid, signal.SIGTERM)
    except Exception as exc:  # noqa: BLE001
        print(json.dumps({"stopped": False, "reason": str(exc)}, ensure_ascii=False))
        return 1
    port = read_port()
    for _ in range(30):
        if not port or not healthy(port, 0.2):
            break
        time.sleep(0.1)
    try:
        PORTFILE.unlink()
    except OSError:
        pass
    print(json.dumps({"stopped": True, "pid": pid}, ensure_ascii=False))
    return 0


def main():
    parser = argparse.ArgumentParser(prog="sec", description="密码链接输入 + 命令注入")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("request")
    p.add_argument("--env", action="append", default=[])
    p.add_argument("--stdin", action="store_true")
    p.add_argument("--ttl", type=int, default=DEFAULT_TTL)
    p.add_argument("--reason", default="")
    p.add_argument("command", nargs=argparse.REMAINDER)
    p.set_defaults(func=cmd_request)

    p = sub.add_parser("wait")
    p.add_argument("id", nargs="?")
    p.add_argument("--last", action="store_true", help="用最近一次 request 的 id")
    p.add_argument("--timeout", type=int, default=150, help="等待秒数，默认 150")
    p.set_defaults(func=cmd_wait)

    p = sub.add_parser("status")
    p.add_argument("id", nargs="?")
    p.add_argument("--last", action="store_true")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("render")
    p.add_argument("id", nargs="?")
    p.add_argument("--last", action="store_true")
    p.set_defaults(func=cmd_render)

    p = sub.add_parser("guide")
    p.set_defaults(func=cmd_guide)

    p = sub.add_parser("list")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("stop")
    p.set_defaults(func=cmd_stop)

    p = sub.add_parser("serve")
    p.add_argument("--port", type=int, default=None)
    def _serve(args):
        serve(args.port or configured_port() or pick_port())
        return 0
    p.set_defaults(func=_serve)

    args = parser.parse_args()
    # argparse.REMAINDER 会保留前导 "--"，去掉它
    if args.cmd == "request" and args.command and args.command[0] == "--":
        args.command = args.command[1:]
    sys.exit(args.func(args) or 0)


if __name__ == "__main__":
    main()