ENCODE_TOOLS = {"base64", "xxd", "od", "openssl", "iconv", "gpg", "uudecode", "uuencode"}
KNOWN_BINS = {"git", "docker", "docker-compose", "kubectl", "helm", "psql", "mysql", "redis-cli",
